def program (guarded : Bool) : List LarkCollective.Instr :=
  if guarded then fixedProgram else racyProgram

theorem index_span (p : Shape) : p.rows * 50257 < 2147483648 := p.bound

theorem native_geometry (p : Shape) :
    (geometry p).warp = 64 ∧ (geometry p).block = 1024 ∧ (geometry p).block % 64 = 0 := by
  simp [geometry]

theorem source_sizes : racyProgram.length = 117 ∧ fixedProgram.length = 116 := by decide

