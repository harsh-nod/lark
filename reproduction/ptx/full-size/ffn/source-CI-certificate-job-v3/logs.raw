nch\": {\n        \"grid\": 65536,\n        \"block\": 1,\n        \"warp\": 32\n      },\n      \"unchanged_CUDA_contract_fuel\": [\n        1030,\n        1,\n        1,\n        1\n      ],\n      \"PTX_instructions\": 173\n    },\n    {\n      \"stage\": \"down\",\n      \"reference_contract_language\": \"cuda\",\n      \"shapes\": [\n        [\n          64,\n          1024\n        ],\n        [\n          1024,\n          256\n        ],\n        [\n          64,\n          256\n        ]\n      ],\n      \"dtypes\": [\n        \"float16\",\n        \"float16\",\n        \"float16\"\n      ],\n      \"launch\": {\n        \"grid\": 16384,\n        \"block\": 1,\n        \"warp\": 32\n      },\n      \"unchanged_CUDA_contract_fuel\": [\n        4102,\n        1,\n        1,\n        1\n      ],\n      \"PTX_instructions\": 171\n    }\n  ],\n  \"host_launch_order\": [\n    \"up\",\n    \"down\"\n  ],\n  \"shared_intermediate\": {\n    \"name\": \"hidden\",\n    \"shape\": [\n      64,\n      1024\n    ],\n    \"dtype\": \"float16\"\n  },\n  \"input_bindings\": {\n    \"up/kernel.ptx\": \"299d828a47a8387a62a3da1dc1de6fa2d053fd2dffefaf150cc40ffdfd6de0e0\",\n    \"down/kernel.ptx\": \"8a2098b08ca67dd40f62e5ddf5e83d445c6dcdbb9a68875e55051f761c6b5413\",\n    \"reference.py\": \"00c8a9cdf04ba58b14dcfa61ea655bc527713a226cddabe304bd982cc1210879\",\n    \"up/contract.json\": \"2e0816934d773d6263c15097af56792b350392b70b3f890c3acf9a774e88b416\",\n    \"down/contract.json\": \"cb6bb588c4ccd398973655cab68687aedf698ba4a1e1e42db3a7b17f4f8c66f9\"\n  },\n  \"main_sha256\": \"49a34ed7505f4ff5dac2b8eb6f2544dc7235411a010a2c02994c44adfcfde195\",\n  \"reference_ast_sha256\": \"43620dd8b8650f29336e9316181587ceb5c3b5f0ffe0dda9d18014b815146ba1\",\n  \"source_bindings_sha256\": \"f9ea5e8d9d84da47edc36e50c63b270f1bff6aa41e79a9ba442eeb55aea92f1b\",\n  \"lean_version\": \"Lean (version 4.19.0, x86_64-unknown-linux-gnu, commit 6caaee842e94, Release)\",\n  \"lean_binary_sha256\": \"92c3d35b5