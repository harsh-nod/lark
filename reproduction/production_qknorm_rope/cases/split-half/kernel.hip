extern "C" __global__ void fused_qknorm_rope(__half* output, const __half* qkv, const __half* q_weight, const __half* k_weight, const __half* cache) {
  int headGlobal = blockIdx.x * 8 + threadIdx.x / 32;
  int row = headGlobal / 40;
  int head = headGlobal % 40;
  int lane = threadIdx.x % 32;
  int column = lane * 4;
  int inputBase = row * 6144 + head * 128 + column;
  int outputBase = row * 5120 + head * 128 + column;
  int a0 = inputBase + 0;
  float x0 = __half2float(qkv[a0]);
  int a1 = inputBase + 1;
  float x1 = __half2float(qkv[a1]);
  int a2 = inputBase + 2;
  float x2 = __half2float(qkv[a2]);
  int a3 = inputBase + 3;
  float x3 = __half2float(qkv[a3]);
  float ss = 0.0f;
  float square0 = x0 * x0;
  ss = ss + square0;
  float square1 = x1 * x1;
  ss = ss + square1;
  float square2 = x2 * x2;
  ss = ss + square2;
  float square3 = x3 * x3;
  ss = ss + square3;
  float peer;
  peer = __shfl_xor(ss, 16, 32);
  ss = ss + peer;
  peer = __shfl_xor(ss, 8, 32);
  ss = ss + peer;
  peer = __shfl_xor(ss, 4, 32);
  ss = ss + peer;
  peer = __shfl_xor(ss, 2, 32);
  ss = ss + peer;
  peer = __shfl_xor(ss, 1, 32);
  ss = ss + peer;
  float mean = ss / 128.0f;
  float shifted = mean + 0.00001f;
  float scale = rsqrtf(shifted);
  int w0 = column + 0;
  float weight0;
  int w1 = column + 1;
  float weight1;
  int w2 = column + 2;
  float weight2;
  int w3 = column + 3;
  float weight3;
  if (head < 32) {
    weight0 = __half2float(q_weight[w0]);
    weight1 = __half2float(q_weight[w1]);
    weight2 = __half2float(q_weight[w2]);
    weight3 = __half2float(q_weight[w3]);
  } else {
    weight0 = __half2float(k_weight[w0]);
    weight1 = __half2float(k_weight[w1]);
    weight2 = __half2float(k_weight[w2]);
    weight3 = __half2float(k_weight[w3]);
  }
  float scaledWeight0 = scale * weight0;
  float n0 = x0 * scaledWeight0;
  float scaledWeight1 = scale * weight1;
  float n1 = x1 * scaledWeight1;
  float scaledWeight2 = scale * weight2;
  float n2 = x2 * scaledWeight2;
  float scaledWeight3 = scale * weight3;
  float n3 = x3 * scaledWeight3;
  __syncwarp();
  float p0 = __shfl_xor(n0, 16, 32);
  float p1 = __shfl_xor(n1, 16, 32);
  float p2 = __shfl_xor(n2, 16, 32);
  float p3 = __shfl_xor(n3, 16, 32);
  if (lane < 16) {
    p0 = -p0;
    p1 = -p1;
    p2 = -p2;
    p3 = -p3;
  }
  int ca0 = row * 128 + (column + 0) % 64;
  int sa0 = ca0 + 64;
  float c0 = __half2float(cache[ca0]);
  float s0 = __half2float(cache[sa0]);
  float xc0 = n0 * c0;
  float ps0 = p0 * s0;
  float o0 = xc0 + ps0;
  int ca1 = row * 128 + (column + 1) % 64;
  int sa1 = ca1 + 64;
  float c1 = __half2float(cache[ca1]);
  float s1 = __half2float(cache[sa1]);
  float xc1 = n1 * c1;
  float ps1 = p1 * s1;
  float o1 = xc1 + ps1;
  int ca2 = row * 128 + (column + 2) % 64;
  int sa2 = ca2 + 64;
  float c2 = __half2float(cache[ca2]);
  float s2 = __half2float(cache[sa2]);
  float xc2 = n2 * c2;
  float ps2 = p2 * s2;
  float o2 = xc2 + ps2;
  int ca3 = row * 128 + (column + 3) % 64;
  int sa3 = ca3 + 64;
  float c3 = __half2float(cache[ca3]);
  float s3 = __half2float(cache[sa3]);
  float xc3 = n3 * c3;
  float ps3 = p3 * s3;
  float o3 = xc3 + ps3;
  __syncwarp();
  int out0 = outputBase + 0;
  output[out0] = __float2half(o0);
  int out1 = outputBase + 1;
  output[out1] = __float2half(o1);
  int out2 = outputBase + 2;
  output[out2] = __float2half(o2);
  int out3 = outputBase + 3;
  output[out3] = __float2half(o3);
}
